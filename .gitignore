# Environment variables & secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies & virtual environments
node_modules/
.venv/
venv/
env/
**/venv/
**/.venv/
*.egg-info/
**/*.egg-info/

# Python caches & build artifacts
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend build & Vite artifacts
dist/
build/
.vite/

# Logs, OS & editor files
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local runtime databases
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Local runtime uploads & generated reports/heatmaps
backend/uploads/*
!backend/uploads/.gitkeep
backend/results/*
!backend/results/.gitkeep
uploads/*
results/*

# Raw large datasets & archives (exclude from Git, keep benchmark test fixtures)
DL/chest-xray/dataset/*
!DL/chest-xray/dataset/.gitkeep
DL/chest-xray/data/*
!DL/chest-xray/data/.gitkeep
DL/brain-mri-tumor/dataset/*
!DL/brain-mri-tumor/dataset/.gitkeep
datasets/
Chest-Xray-Pneumonia/data/
*.zip
*.tar
*.tar.gz

# Model checkpoints rules (ignore extra weights, preserve released canonical checkpoints)
*.pth
!DL/chest-xray/models/checkpoints/best_model_pytorch.pth
!DL/chest-xray/outputs/models/best_model_pytorch.pth
!DL/brain-mri-tumor/models/checkpoints/tumor_model.pth
!DL/brain-mri-tumor/checkpoints/tumor_model.pth
